<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://example.com/process">
    
    <process id="product_processing_without_jobs" isExecutable="true">
        
        <startEvent id="start">
            <extensionElements>
                <flowable:formProperty id="products" name="Список товаров" type="json"/>
            </extensionElements>
        </startEvent>
        
        <subProcess id="processProductSubprocess" name="subProcess">
            <multiInstanceLoopCharacteristics 
                isSequential="false" 
                flowable:collection="products" 
                flowable:elementVariable="product">
                <completionCondition>${nrOfCompletedInstances == nrOfInstances}</completionCondition>
            </multiInstanceLoopCharacteristics>
            
            <startEvent id="subProcessStart"/>
            
            <serviceTask id="processActionTask" 
                         flowable:delegateExpression="${processAction}">
                <extensionElements>
                    <flowable:field name="product">
                        <flowable:expression><![CDATA[${product}]]></flowable:expression>
                    </flowable:field>
                </extensionElements>
            </serviceTask>
            
            <!-- FIX: User Task с назначением и правильными listeners -->
            <userTask id="waitForResponse" name="Ожидание асинхронного ответа"
                     flowable:assignee="${systemUser}">  <!-- Назначение -->
                <extensionElements>
                    <!-- FIX: executionListener -> taskListener -->
                    <flowable:taskListener event="create" 
                        delegateExpression="${processListener}"/>
                    <flowable:taskListener event="complete" 
                        delegateExpression="${afterProcessListener}"/>
                    
                    <!-- Форма для отслеживания статуса -->
                    <flowable:formProperty id="responseReceived" 
                        name="Ответ получен" 
                        type="boolean" 
                        default="false"/>
                    
                    <!-- Категория для фильтрации -->
                    <flowable:taskListener event="create">
                        <flowable:field name="category">
                            <flowable:string>ASYNC_WAIT</flowable:string>
                        </flowable:field>
                    </flowable:taskListener>
                </extensionElements>
            </userTask>
            
            <endEvent id="subProcessEnd"/>
            
            <sequenceFlow sourceRef="subProcessStart" targetRef="processActionTask"/>
            <sequenceFlow sourceRef="processActionTask" targetRef="waitForResponse"/>
            <sequenceFlow sourceRef="waitForResponse" targetRef="subProcessEnd"/>
        </subProcess>
        
        <serviceTask id="cleanupProducts" 
                     flowable:delegateExpression="${productCleanup}">
            <extensionElements>
                <flowable:field name="products">
                    <flowable:expression><![CDATA[${products}]]></flowable:expression>
                </flowable:field>
            </extensionElements>
        </serviceTask>
        
        <endEvent id="end"/>
        
        <sequenceFlow sourceRef="start" targetRef="processProductSubprocess"/>
        <sequenceFlow sourceRef="processProductSubprocess" targetRef="cleanupProducts"/>
        <sequenceFlow sourceRef="cleanupProducts" targetRef="end"/>
    </process>
</definitions>