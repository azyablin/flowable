  <signal id="asyncResponseSignal" name="ASYNC_RESPONSE_SIGNAL" flowable:scope="global"></signal>
  <process id="product_processing" name="Обработка товаров с условиями" isExecutable="true">
    <startEvent id="start" flowable:formFieldValidation="true">
      <extensionElements>
        <flowable:formProperty id="products" name="Список товаров" type="json"></flowable:formProperty>
      </extensionElements>
    </startEvent>
    <subProcess id="processProductSubprocess" name="subProcess" flowable:async="true" flowable:exclusive="false">
      <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="products" flowable:elementVariable="product">
