        <completionCondition>${nrOfCompletedInstances == nrOfInstances}</completionCondition>
      </multiInstanceLoopCharacteristics>
      <startEvent id="subProcessStart" flowable:formFieldValidation="true"></startEvent>
      <serviceTask id="processActionTask" flowable:delegateExpression="${processAction}">
        <extensionElements>
          <flowable:field name="product">
            <flowable:expression><![CDATA[${product}]]></flowable:expression>
          </flowable:field>
        </extensionElements>
      </serviceTask>
      <exclusiveGateway id="decisionGateway"></exclusiveGateway>
      <intermediateCatchEvent id="waitForResponse" name="Wait for Async Response">
        <signalEventDefinition signalRef="asyncResponseSignal"></signalEventDefinition>
      </intermediateCatchEvent>
      <serviceTask id="asyncResponseHandler" flowable:delegateExpression="${asyncResponseHandler}">
        <extensionElements>
          <flowable:field name="product">
            <flowable:expression><![CDATA[${product}]]></flowable:expression>
          </flowable:field>
        </extensionElements>
      </serviceTask>
      <serviceTask id="nextActionTask" flowable:delegateExpression="${nextAction}">
        <extensionElements>
          <flowable:field name="product">
            <flowable:expression><![CDATA[${product}]]></flowable:expression>
          </flowable:field>
        </extensionElements>
      </serviceTask>
      <serviceTask id="finishActionTask" flowable:delegateExpression="${finishAction}">
        <extensionElements>
          <flowable:field name="product">
            <flowable:expression><![CDATA[${product}]]></flowable:expression>
          </flowable:field>
        </extensionElements>
      </serviceTask>
      <endEvent id="subProcessEnd"></endEvent>
      <sequenceFlow id="flow1" sourceRef="subProcessStart" targetRef="processActionTask"></sequenceFlow>
      <sequenceFlow id="flow2" sourceRef="processActionTask" targetRef="decisionGateway"></sequenceFlow>
      <sequenceFlow id="flow3" sourceRef="waitForResponse" targetRef="asyncResponseHandler"></sequenceFlow>
      <sequenceFlow id="flow4" sourceRef="asyncResponseHandler" targetRef="subProcessEnd"></sequenceFlow>
      <sequenceFlow id="flow5" sourceRef="nextActionTask" targetRef="subProcessEnd"></sequenceFlow>
      <sequenceFlow id="flow6" sourceRef="finishActionTask" targetRef="subProcessEnd"></sequenceFlow>
      <sequenceFlow id="toFinish" sourceRef="decisionGateway" targetRef="finishActionTask">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${actionResult == 'FINISH'}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="toNext" sourceRef="decisionGateway" targetRef="nextActionTask">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${actionResult == 'NEXT'}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="toWait" sourceRef="decisionGateway" targetRef="waitForResponse">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${actionResult == 'WAIT'}]]></conditionExpression>
      </sequenceFlow>
    </subProcess>
    <serviceTask id="cleanupProducts" flowable:delegateExpression="${productCleanup}">
      <extensionElements>
        <flowable:field name="products">
          <flowable:expression><![CDATA[${products}]]></flowable:expression>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <endEvent id="end"></endEvent>
    <sequenceFlow id="flow7" sourceRef="start" targetRef="processProductSubprocess"></sequenceFlow>
    <sequenceFlow id="flow8" sourceRef="processProductSubprocess" targetRef="cleanupProducts"></sequenceFlow>
    <sequenceFlow id="flow9" sourceRef="cleanupProducts" targetRef="end"></sequenceFlow>
