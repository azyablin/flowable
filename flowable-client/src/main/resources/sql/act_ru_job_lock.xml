<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd">

    <changeSet id="20260727-act-ru-job-lock" author="copilot">
        <createTable tableName="ACT_RU_JOB_LOCK">
            <column name="ID_" type="NVARCHAR2(64)">
                <constraints nullable="false"/>
            </column>
            <column name="LOCK_EXP_TIME_" type="TIMESTAMP(6)"/>
            <column name="LOCK_OWNER_" type="NVARCHAR2(255)"/>
        </createTable>

        <createIndex tableName="ACT_RU_JOB_LOCK" indexName="ACT_RU_JOB_LOCK_UNQ" unique="true">
            <column name="ID_"/>
        </createIndex>

        <addForeignKeyConstraint baseTableName="ACT_RU_JOB_LOCK"
                                 baseColumnNames="ID_"
                                 constraintName="fk_act_ru_job_lock_job"
                                 referencedTableName="ACT_RU_JOB"
                                 referencedColumnNames="ID_"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>