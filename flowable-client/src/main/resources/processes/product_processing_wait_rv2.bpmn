          <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
        </extensionElements>
      </sequenceFlow>
    </subProcess>
    <serviceTask id="cleanupProducts" flowable:delegateExpression="${productCleanup}">
      <extensionElements>
