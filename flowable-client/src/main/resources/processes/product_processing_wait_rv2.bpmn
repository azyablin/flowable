    </extensionElements>
    <subProcess id="processProductSubprocess" name="subProcess" flowable:async="true" flowable:exclusive="false">
      <extensionElements>
        <design:stencilid><![CDATA[ExpandedSubProcess]]></design:stencilid>
      </extensionElements>
      <multiInstanceLoopCharacteristics isSequential="false" flowable:collection="products" flowable:elementVariable="product" flowable:noWaitStatesAsyncLeave="true">
        <extensionElements></extensionElements>
        <completionCondition>${nrOfCompletedInstances == nrOfInstances}</completionCondition>
      </multiInstanceLoopCharacteristics>
      <boundaryEvent id="IntermediateErrorEventBoundary_1" attachedToRef="ExpandedSubProcess_2">
        <extensionElements>
          <design:stencilid><![CDATA[IntermediateErrorEventBoundary]]></design:stencilid>
        </extensionElements>
        <errorEventDefinition></errorEventDefinition>
      </boundaryEvent>
      <sequenceFlow id="SequenceFlow_10" sourceRef="IntermediateErrorEventBoundary_1" targetRef="ServiceTask_2">
